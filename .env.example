VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional alias for the same public browser key (Supabase dashboard "anon" key).
# The app accepts either VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_ANON_KEY=

# Use only the publishable/anon key in the frontend.
# Never put a service_role or secret key in this file for the website.

# Storage: create buckets named `photos` and `voices` (or run supabase/storage.sql).
# Database: run supabase/photos.sql then supabase/messages.sql.
# Then run supabase/complete.sql (challenge columns, voices, reactions, votes, realtime).
# Optional: supabase/storage.sql for storage policies.
# Reset test rows later with supabase/reset-test-data.sql
# Realtime: complete.sql adds photos, messages, voices, reactions, photo_votes to supabase_realtime.
